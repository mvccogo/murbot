# ==============================================================================
# DISCORD BOT CONFIGURATION
# ==============================================================================
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_PREFIX=!
BOT_NAME=murbot

# ==============================================================================
# OPERATION MODE: "cloud" OR "local"
# Set to "cloud" to use cloud APIs (Groq, OpenAI, etc.)
# Set to "local" for 100% offline local inference (Docker / Ollama + Faster-Whisper)
# ==============================================================================
MODE=cloud

# ==============================================================================
# LLM BRAIN CONFIGURATION
# Provider options: "cloud", "local", "groq", "openai", "ollama", "deepseek"
# Default cloud uses Groq (lightning-fast Llama 3.3 70B ~300 tok/sec, generous free tier)
# ==============================================================================
LLM_PROVIDER=cloud
OPENAI_API_KEY=gsk_your_groq_or_openai_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# DeepSeek Flash: set MODE=cloud and LLM_PROVIDER=deepseek.
# Key falls back to DEEP_SEEK_API_KEY or OPENAI_API_KEY if unset/empty.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Thinking is disabled for low-latency streamed voice and tool compatibility.

# Local LLM settings (Ollama on host or via Docker container)
# qwen2.5:3b uses ~2.0 GB VRAM (Q4_K_M) - fits easily under 3GB VRAM
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:3b

# ==============================================================================
# STT (SPEECH-TO-TEXT) CONFIGURATION
# Options: "local" (uses GPU RTX 2070 via faster-whisper) or "cloud" (Groq/OpenAI Whisper)
# ==============================================================================
STT_PROVIDER=local
LOCAL_WHISPER_MODEL=large-v3-turbo
LOCAL_WHISPER_DEVICE=cuda
LOCAL_WHISPER_COMPUTE=float16
CLOUD_WHISPER_MODEL=whisper-large-v3-turbo

# ==============================================================================
# TTS (TEXT-TO-SPEECH) CONFIGURATION
# Options:
# - "kokoro": SOTA open-source local model via Docker (ultra-natural human tones & pauses)
# - "edge": Free studio-grade Microsoft neural pt-BR (no API key, zero setup)
# - "openai": Cloud OpenAI TTS (tts-1)
# ==============================================================================
TTS_PROVIDER=kokoro

# Kokoro TTS (runs locally via docker-compose up -d kokoro-tts)
LOCAL_TTS_BASE_URL=http://localhost:8880/v1
# Kokoro Brazilian Portuguese voices:
# - pf_dora (Female, expressive and natural)
# - pm_alex (Male, conversational)
# - pm_santa (Male, mature)
# Tip: You can also mix voices like: pf_dora(2)+pm_alex(1)
KOKORO_VOICE=pf_dora
KOKORO_SPEED=1.05

# Edge-TTS settings (Used if TTS_PROVIDER=edge or as automatic fallback)
TTS_VOICE=pt-BR-FranciscaNeural
TTS_RATE=+10%

# ==============================================================================
# REAL-TIME BARGE-IN (INTERRUPTION) & VAD
# ==============================================================================
VAD_THRESHOLD=0.60
INTERRUPTION_ENABLED=true
INTERRUPTION_FRAMES_THRESHOLD=6
SILENCE_DURATION_MS=550

# Storage
MEMORIES_DIR=data/memories
SKILLS_DIR=data/skills

# Independent speech API endpoints (not the LLM endpoint)
BOT_ALIASES=mur bot
STT_LANGUAGE=pt
# Optional vocabulary for local Whisper. Empty biases toward BOT_NAME/BOT_ALIASES.
STT_HOTWORDS=
STT_BASE_URL=https://api.groq.com/openai/v1
# STT_API_KEY=your_stt_key
TTS_BASE_URL=https://api.openai.com/v1
# TTS_API_KEY=your_tts_key
TTS_MODEL=tts-1
API_TTS_VOICE=nova
LLM_TOOLS_ENABLED=true
STT_MIN_RMS=0.003
MAX_UTTERANCE_SECONDS=20
# Optional temporary capture for debugging. Delete WAVs after inspection.
DEBUG_AUDIO_DIR=


# Live partial transcripts from local Whisper (enabled by default)
STT_STREAMING_ENABLED=true
STT_STREAM_MIN_AUDIO_MS=640
STT_STREAM_INTERVAL_MS=320
STT_STREAM_WINDOW_SECONDS=6
STT_MAX_STREAMS=8

# Native streaming alternative: STT_PROVIDER=deepgram
# DEEPGRAM_API_KEY=your_deepgram_key
DEEPGRAM_WS_URL=wss://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=pt-BR

# Same speaker can ask follow-ups without the name; intent must be clearly directed at the bot.
# Side conversations do not interrupt playback. Zero requires the name every time.
CONVERSATION_FOLLOWUP_SECONDS=20
CONVERSATION_SEMANTIC_FOLLOWUPS=true
# Include recognized speech in console and rotated file logs.
STT_LOG_TRANSCRIPTS=true

# Persistent logs: current file plus ten 10 MiB backups (~110 MiB maximum).
LOG_DIR=logs
LOG_LEVEL=DEBUG
LOG_CONSOLE_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ElevenLabs HTTP streaming TTS (set TTS_PROVIDER=elevenlabs)
# Both ELEVENLABS_API_KEY and ELEVEN_LABS_API_KEY are accepted.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=RGymW84CSmfVugnA5tvA
ELEVENLABS_MODEL=eleven_v4_turbo
ELEVENLABS_LANGUAGE=pt
ELEVENLABS_SPEED=1.0
